---
const projects = [
  {
    title: "Raíces",
    desc: "Website for a cafe located in Marinilla, Antioquia, Colombia.",
    tags: ["Astro", "Tailwind", "TS"],
    color: "#4CAF50",
    emoji: "🌱",
    status: "In progress",
    liveLink: "https://raices-cafe.vercel.app/",
    repoLink: "https://github.com/Alej0510/Raices",
  },
  {
    title: "To-Do App",
    desc: "A simple To-Do application for managing daily tasks with dark mode toggle.",
    tags: ["React", "TS"],
    color: "#FF9800",
    emoji: "✅",
    status: "Completed",
    liveLink: "https://to-do-two-wheat.vercel.app/",
    repoLink: "https://github.com/Alej0510/To-Do",
  },
  {
    title: "5 Direcciones",
    desc: "Website for a business consulting firm located in Medellín, Antioquia, Colombia.",
    tags: ["Astro", "Tailwind", "TS"],
    color: "#E91E63",
    emoji: "🧭",
    status: "Completed",
    liveLink: "https://5direcciones.vercel.app/",
    repoLink: "https://github.com/Alej0510/5Direcciones",
  },
];

const statusStyle: Record<string, string> = {
  Live: "bg-teal/10 text-teal border border-teal/30",
  "In progress": "bg-amber-500/10 text-amber-400 border border-amber-500/30",
  Completed: "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30",
};
---

<section id="projects" class="py-32 px-16 max-md:py-20 max-md:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center gap-4 mb-5">
      <span class="font-display text-[0.72rem] font-bold text-teal opacity-60"
        >03</span
      >
      <span class="text-[0.68rem] tracking-widest uppercase text-[#888]"
        >Projects</span
      >
    </div>

    <h2
      class="font-display font-extrabold text-[2rem] leading-tight tracking-tight mb-4"
    >
      What I've <span class="text-teal">built</span>
    </h2>

    <div
      class="flex items-center gap-2 text-[0.78rem] text-[#888] bg-[#181818] border border-[#222] border-l-2 border-l-teal px-4 py-3 rounded mb-12"
    >
      <svg
        class="text-teal shrink-0"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="10"></circle><line
          x1="12"
          y1="8"
          x2="12"
          y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      I'm a developer in training. These projects represent my learning process. Contact
      me if you want to collaborate!
    </div>

    <div class="grid grid-cols-2 gap-6 mb-12 max-md:grid-cols-1">
      {
        projects.map((p, i) => (
          <div
            class="project-card bg-[#181818] border border-[#222] rounded-xl p-8 flex flex-col gap-4 relative overflow-hidden transition-all duration-300 hover:-translate-y-1"
            style={`--accent:${p.color}; animation: fadeUp 0.6s ${i * 0.1}s ease both;`}
          >
            <div class="flex items-center justify-between">
              <span class="text-[2rem] leading-none">{p.emoji}</span>
              <span
                class={`text-[0.65rem] font-medium tracking-[0.1em] uppercase px-3 py-1 rounded-full ${statusStyle[p.status]}`}
              >
                {p.status}
              </span>
            </div>
            <h3 class="font-display font-bold text-[1.05rem]">{p.title}</h3>
            <p class="text-[0.85rem] text-[#CCC] leading-relaxed flex-1">
              {p.desc}
            </p>
            <div class="flex gap-2 flex-wrap mb-2">
              {p.tags.map((t) => (
                <span class="text-[0.65rem] font-medium tracking-wide px-3 py-1 bg-[#222] rounded-full text-[#888] transition-all">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-3 mt-auto pt-6 border-t border-white/5">
              {p.liveLink && (
                <a
                  href={p.liveLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-teal/10 border border-teal/20 rounded-lg text-[0.72rem] font-bold text-teal hover:bg-teal hover:text-black transition-all duration-300"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  Live Demo
                </a>
              )}
              {p.repoLink && (
                <a
                  href={p.repoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-white/5 border border-white/10 rounded-lg text-[0.72rem] font-bold text-white/70 hover:bg-white/10 hover:text-white transition-all duration-300"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                  GitHub
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex justify-center">
      <a
        href="https://github.com/Alej0510?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-3.5 bg-[#181818] border border-[#222] rounded-lg text-[0.83rem] text-[#CCC] hover:border-teal hover:text-[#F5F5F5] hover:-translate-y-0.5 transition-all"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        View all my repos on GitHub
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M7 17L17 7M17 7H7M17 7v10"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }
  .project-card:hover::before {
    transform: scaleX(1);
  }
  .project-card:hover {
    border-color: var(--accent);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
