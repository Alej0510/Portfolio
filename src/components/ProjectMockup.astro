---
interface Props {
  src?: string;
  alt?: string;
  variant?: "dark" | "light";
}

const { src, alt = "", variant = "dark" } = Astro.props;

const barBg = variant === "light" ? "#e5e5e5" : "#1e1e1e";
const hasSrc = typeof src === "string" && src.length > 0;
---

<div class="mockup-frame">
  <div class="mockup-bar" style={`background:${barBg};`}>
    <span class="dot" style="background:#ff5f57;"></span>
    <span class="dot" style="background:#febc2e;"></span>
    <span class="dot" style="background:#28c840;"></span>
  </div>
  {
    hasSrc ? (
      <img
        class="mockup-img"
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        width="1600"
        height="1000"
      />
    ) : (
      <div class="mockup-fallback" role="img" aria-label={alt}>
        <svg
          class="fallback-icon"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
      </div>
    )
  }
</div>

<style>
  .mockup-frame {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    border: 1px solid #222;
  }

  .mockup-bar {
    height: 28px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .mockup-img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  .mockup-fallback {
    width: 100%;
    aspect-ratio: 1600 / 1000;
    background: linear-gradient(135deg, #181818 0%, #222222 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #444;
  }

  .fallback-icon {
    opacity: 0.5;
  }
</style>
