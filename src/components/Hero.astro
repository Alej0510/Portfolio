---

---

<section
  id="inicio"
  class="relative min-h-screen grid grid-cols-2 gap-16 items-center px-16 pt-20 overflow-hidden max-lg:grid-cols-1 max-lg:px-6 max-lg:pt-24 max-lg:pb-12 max-lg:text-left"
>
  <!-- Background -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(0,188,212,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,188,212,0.04) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
    <div
      class="absolute w-[480px] h-[480px] rounded-full opacity-15 blur-[80px] bg-teal top-[-80px] right-[-80px] animate-float"
    >
    </div>
    <div
      class="absolute w-[280px] h-[280px] rounded-full opacity-10 blur-[80px] bg-teal-dark bottom-16 left-[10%]"
      style="animation: blobFloat 10s ease-in-out infinite reverse;"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 animate-fade-up max-lg:order-1">
    <div
      class="inline-flex items-center gap-2 text-[0.7rem] tracking-wider uppercase text-teal border border-teal/30 px-4 py-1.5 rounded-full mb-8"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-teal animate-pulse"></span>
      Available for projects
    </div>

    <h1
      class="font-display font-extrabold text-[3.5rem] leading-[1] tracking-tight mb-5 max-lg:text-[2.8rem]"
    >
      Alejandro<br />
      <span class="text-teal">Cardona</span>
    </h1>

    <p
      class="font-display text-sm font-semibold tracking-widest uppercase text-[#888] mb-5"
    >
      Web <span class="text-[#F5F5F5]">Developer</span>
    </p>

    <p class="text-[0.95rem] text-[#CCC] max-w-md leading-[1.85] mb-10">
      Software Engineering student who creates dynamic, accessible, and
      optimized interfaces. Specialized in the React ecosystem and modern web
      technologies.
    </p>

    <div class="flex gap-4 flex-wrap">
      <a
        class="group relative inline-flex items-center gap-3 overflow-hidden rounded-full px-8 py-4 font-display text-[0.8rem] font-bold tracking-[0.05em] uppercase text-white transition-all duration-500 hover:scale-[1.05] active:scale-[0.98]"
        href="/CurriculumEN.pdf"
        target="_blank"
      >
        <!-- Animated Gradient Background -->
        <div
          class="absolute inset-0 bg-gradient-to-r from-teal-dark via-teal to-teal-dark bg-[length:200%_auto] animate-gradient-x"
        >
        </div>

        <!-- Hover Glow Overlay -->
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[inset_0_0_20px_rgba(255,255,255,0.2)]"
        >
        </div>

        <!-- Shimmer Effect -->
        <div
          class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-1000 group-hover:translate-x-full"
        >
        </div>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="relative z-10 transition-transform duration-500 group-hover:rotate-[12deg] group-hover:scale-110"
        >
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
          ></path>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
          <path d="M10 9H8"></path>
          <path d="M16 13H8"></path>
          <path d="M16 17H8"></path>
        </svg>
        <span class="relative z-10">Curriculum</span>
      </a>

      <a
        href="#contacto"
        class="group relative inline-flex items-center gap-2 px-8 py-4 text-[0.75rem] font-bold tracking-[0.2em] uppercase text-[#F5F5F5] transition-all duration-300"
      >
        <span class="relative z-10 group-hover:text-teal transition-colors">
          Contact
          <span
            class="absolute -bottom-1 left-0 w-0 h-[1px] bg-teal transition-all duration-300 group-hover:w-full"
          ></span>
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="relative z-10 transition-transform duration-300 group-hover:translate-x-1.5 group-hover:text-teal"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Visual -->
  <div
    class="relative z-10 flex flex-col gap-6 max-lg:order-2"
    style="animation: fadeUp 0.8s 0.2s ease both;"
  >
    <!-- Code card -->
    <div
      class="bg-[#181818] border border-[#222] rounded-lg overflow-hidden shadow-2xl hover:-translate-y-1 hover:shadow-teal/10 hover:border-teal/20 transition-all duration-300"
    >
      <div
        class="flex items-center gap-2 px-5 py-3 bg-[#222] border-b border-white/5"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
        <span class="ml-auto text-[0.72rem] text-[#888] font-mono"
          >alejandro.tsx</span
        >
      </div>
      <pre
        class="p-6 font-mono text-[0.8rem] leading-[1.85] overflow-x-auto"><code><span class="text-[#C792EA]">const</span> <span class="text-[#82AAFF]">Alejandro</span> <span class="text-[#888]">=</span> () <span class="text-[#888]">=&gt;</span> &#123;
  <span class="text-[#C792EA]">const</span> skills <span class="text-[#888]">=</span> [
    <span class="text-teal">'Astro'</span>, <span class="text-teal">'React'</span>, <span class="text-teal">'TypeScript'</span>,
    <span class="text-teal">'Tailwind'</span>, <span class="text-teal">'PostgreSQL'</span>, <span class="text-teal">'Supabase'</span>,
    <span class="text-teal">'C#'</span>, <span class="text-teal">'Git'</span>
  ];

  <span class="text-[#C792EA]">return</span> (
    <span class="text-[#F07178]">&lt;Developer</span>
      <span class="text-[#FFCB6B]">name</span><span class="text-[#888]">=</span><span class="text-teal">"Alejandro"</span>
      <span class="text-[#FFCB6B]">location</span><span class="text-[#888]">=</span><span class="text-teal">"Medellín 🇨🇴"</span>
      <span class="text-[#FFCB6B]">open</span><span class="text-[#888]">=</span>&#123;<span class="text-[#C792EA]">true</span>&#125;
      <span class="text-[#FFCB6B]">skills</span><span class="text-[#888]">=</span>&#123;skills&#125;
    <span class="text-[#F07178]">/&gt;</span>
  );
&#125;;</code></pre>
    </div>

    <!-- Stats -->
    <div
      class="grid grid-cols-2 divide-x divide-[#222] border border-[#222] rounded-lg overflow-hidden"
    >
      {
        [
          { num: "8+", label: "Technologies" },
          { num: "B2", label: "English" },
        ].map((s) => (
          <div class="bg-[#181818] px-4 py-5 text-center hover:bg-[#222] transition-colors">
            <span class="block font-display font-extrabold text-[1.6rem] text-teal leading-none mb-1">
              {s.num}
            </span>
            <span class="text-[0.65rem] tracking-[0.1em] uppercase text-[#888]">
              {s.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes blobFloat {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(20px, -30px) scale(1.05);
    }
  }
  @keyframes scrollPulse {
    0%,
    100% {
      width: 60px;
      opacity: 1;
    }
    50% {
      width: 100px;
      opacity: 0.5;
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes gradient-x {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  .animate-gradient-x {
    animation: gradient-x 3s linear infinite;
  }
</style>
